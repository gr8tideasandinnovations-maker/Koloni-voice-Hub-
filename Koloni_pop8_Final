from flask import Flask, request, jsonify
import threading
import time
import urllib.request

app = Flask(__name__)

@app.route('/')
def home():
    return jsonify(app="KOLONI Voice Hub - NExtop Tech", author="BOBOYE OLUSOLA OLUWAFEMI", status="Online", phone="Tecno Pop 8 Go", result="SUCCESS")

@app.route('/emergency')
def emergency():
    q = request.args.get('question','')
    return jsonify(emergency=True, message="HELP COMING Police 199", question=q)

def run_server():
    app.run(host="127.0.0.1", port=8080, debug=False, use_reloader=False)

# Start server in background
thread = threading.Thread(target=run_server, daemon=True)
thread.start()

print("Starting server...")
time.sleep(3)

