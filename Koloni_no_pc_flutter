def getAnswer(question, sector="Agriculture"):
    q = question.lower().strip()
    
    # EMERGENCY FIRST - Most important for Pop 8 Go
    if any(word in q for word in ["ole", "thief", "robber", "help", "emergency", "sos", "arm robber"]):
        print("\n🚨 EMERGENCY DETECTED! 🚨")
        for key in sectorKB["Emergency"]:
            if key in q or any(w in q for w in key.split()):
                return sectorKB["Emergency"][key]
        return sectorKB["Emergency"]["help ole"]
    
    # Check requested sector first
    kb = sectorKB.get(sector, sectorKB["Agriculture"])
    
    # Exact multi-word match
    for key in kb.keys():
        parts = key.split(' ')
        if all(p in q for p in parts):
            return kb[key]
    
    # Partial match - first word
    for key in kb.keys():
        if key.split(' ')[0] in q:
            return kb[key]
    
    # Search ALL sectors if not found in current sector
    for sec_name, sec_kb in sectorKB.items():
        if sec_name == "Emergency":
            continue
        for key in sec_kb.keys():
            parts = key.split(' ')
            if all(p in q for p in parts):
                return f"[{sec_name}] {sec_kb[key]}"
    
    return f"We don save your question for {sector}. When you get network, NExtop expert go answer you. Your question: {question}"

